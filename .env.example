# AllDocs production config knobs. Copy to .env.local in web/ to override
# defaults; safe to leave unset in development.

# ---- Upload cap ----

# Maximum upload size, in megabytes. Default: 200.
# Trades user-friendliness against subprocess memory + bandwidth +
# the 180s import timeout. PyMuPDF holds the whole PDF in memory
# while patching / rendering, so raising this much above 200 risks
# OOM and timeouts.
# ALLDOCS_MAX_UPLOAD_MB=200


# ---- Ephemeral storage TTLs ----

# How long uploaded sessions stay in web/public/uploads/ before the
# sweeper deletes them. Default: 24 hours.
# ALLDOCS_UPLOAD_TTL_HOURS=24

# How long bug-report attachments stay in tickets/. Default: 30 days.
# ALLDOCS_TICKET_TTL_DAYS=30

# Minimum gap between sweeper runs. Default: 5 minutes (300000ms).
# ALLDOCS_SWEEP_INTERVAL_MS=300000


# ---- Rate limiting ----

# Per-IP, per-route cap. Token bucket; resets after the window.
# Defaults are tuned to leave normal interactive usage alone while
# stopping accidental loops and obvious abuse.
# ALLDOCS_RATE_LIMIT_PER_MIN=30
# ALLDOCS_RATE_LIMIT_PER_HOUR=300


# ---- Audit log ----

# Salt used to one-way-hash IP addresses in the audit log. CHANGE THIS
# in production so the hashes are unique to your instance.
# ALLDOCS_IP_HASH_SALT=alldocs-default-salt


# ---- Admin dashboard (/admin) ----

# Password for the operator dashboard at /admin (stats + bug-report
# tickets). If UNSET, the admin surface is disabled entirely (every
# admin route returns 503). Set to a long random string to enable.
# ALLDOCS_ADMIN_PASSWORD=


# ---- OCR (optional) ----

# Path to a directory containing extra Tesseract .traineddata language
# packs (deu, fra, ita, spa, chi_sim, jpn, kor, etc.) the user wants
# AllDocs to support. The contents of this directory are merged with
# the system Tesseract tessdata at runtime via symlinks; eng + osd
# come from the system Tesseract install.
# ALLDOCS_TESSDATA=/var/lib/alldocs/tessdata


# ---- Face detection (optional) ----

# Override the path Tesseract looks at for a CJK font. Used when the
# system has no Microsoft YaHei / Hiragino / Noto CJK font and you
# want to provide one yourself.
# ALLDOCS_CJK_FONT=/usr/share/fonts/NotoSansCJK-Regular.ttc
